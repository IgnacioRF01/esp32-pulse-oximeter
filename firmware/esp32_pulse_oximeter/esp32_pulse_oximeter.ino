void setup() {



  
   Serial.begin(115200);
  Serial.setDebugOutput(true);
  Serial.println();

  Serial.println("Running...");
  delay(3000);
  byte ledBrightness = 0x7F; //Options: 0=Off to 255=50mA
  byte sampleAverage = 4; //Options: 1, 2, 4, 8, 16, 32
  byte ledMode       = 2; //Options: 1 = Red only, 2 = Red + IR, 3 = Red + IR + Green
  //Options: 1 = IR only, 2 = Red + IR on MH-ET LIVE MAX30102 board
  int sampleRate     = 200; //Options: 50, 100, 200, 400, 800, 1000, 1600, 3200
  int pulseWidth     = 411; //Options: 69, 118, 215, 411
  int adcRange       = 16384; //Options: 2048, 4096, 8192, 16384
  display.begin(SSD1306_SWITCHCAPVCC, 0x3C);
  display.display();
  delay(3000);
  
  //Configurando e inicializando sensor 
   while (!particleSensor.begin(Wire, I2C_SPEED_FAST)) //Use default I2C port, 400kHz speed
  {
    Serial.println("MAX30102 was not found. Please check wiring/power/solder jumper at MH-ET LIVE MAX30102 board. ");
    //while (1);
  }
  
  // Set up the wanted parameters
  particleSensor.setup(ledBrightness, sampleAverage, ledMode, sampleRate, pulseWidth, adcRange); //Configure sensor with these settings

  particleSensor.enableDIETEMPRDY();
}


void loop() {
  //Envio del valor de BPM a puerto serial
Serial.println(particleSensor.getIR());
/*if(abs(beatAvg-bpmaux)>20){
  display.drawBitmap(100, 5, arritmia, 25, 25, WHITE);
}
else{
display.fillRect(100, 5, 25, 25, WHITE);
  
}*/
long irValue = particleSensor.getIR(); //Reading the IR value it will permit us to know if there's a finger on the sensor or not
//Also detecting a heartbeat
if(irValue > 7000){ //If a finger is detected
display.clearDisplay(); //Clear the display
display.drawBitmap(5, 5, logo2_bmp, 24, 21, WHITE); //Draw the first bmp picture (little heart)
//Inician condicionales de nivel de spo2
if (oxige>100){
  display.drawBitmap(5, 40, oxihiper, 25, 25, WHITE);
}
else if (oxige>95 && oxige<100){
display.drawBitmap(5, 40, oxicool, 20, 20, WHITE);
}
else if (oxige<95 && oxige>90) {
  display.drawBitmap(5, 40, oximaso, 25, 25, WHITE);
}
else if (oxige<90 && oxige>75) {
  display.drawBitmap(5, 40, oximal, 25, 25, WHITE);
}
else{
  display.drawBitmap(5, 40, oximuerto, 25, 25, WHITE);
}
//Inician condicionales de sistema de alerta de oxigenacion
if (beatAvg+cr<60){
  display.drawBitmap(80, 5, corazonroto, 25, 25, WHITE);
}
else if(beatAvg+cr>60 && beatAvg+cr<100){
  display.drawBitmap(80, 5, corazonbien, 25, 25, WHITE);
}
else if (beatAvg+cr>100){
  display.drawBitmap(80, 5, corazonhiper, 25, 25, WHITE);
}


display.setTextSize(1.5); //Near it display the average BPM you can display the BPM if you want
display.setTextColor(WHITE);
display.setCursor(50,0);
display.println("BPM");
display.setCursor(50,18);
display.println(beatAvg+cr);
display.println();
display.println("---------------------");
//Parte oxigenacion 
display.setCursor(50,45);
display.println("SPO2");
display.setCursor(50,54);
display.print(oxige);
display.println("%");
display.display();

if (checkForBeat(irValue) == true) //If a heart beat is detected
{
display.clearDisplay(); //Clear the display
display.drawBitmap(0, 0, logo3_bmp, 32, 32, WHITE); //Draw the second picture (bigger heart)

//Inician condicionales de nivel de spo2
if (oxige>100){
  display.drawBitmap(5, 40, oxihiper, 25, 25, WHITE);
}
else if (oxige>95 && oxige<100){
display.drawBitmap(5, 40, oxicool, 20, 20, WHITE);
}
else if (oxige<95 && oxige>90) {
  display.drawBitmap(5, 40, oximaso, 25, 25, WHITE);
}
else if (oxige<90 && oxige>75) {
  display.drawBitmap(5, 40, oximal, 25, 25, WHITE);
}
else{
  display.drawBitmap(5, 40, oximuerto, 25, 25, WHITE);
}
//Inician condicionales de sistema de alerta de oxigenacion
if (beatAvg+cr<60){
  display.drawBitmap(80, 5, corazonroto, 25, 25, WHITE);
}
else if(beatAvg+cr>60 && beatAvg+cr<100){
  display.drawBitmap(80, 5, corazonbien, 25, 25, WHITE);
}
else if (beatAvg+cr>100){
  display.drawBitmap(80, 5, corazonhiper, 25, 25, WHITE);
}
display.setTextSize(1.5); //And still displays the average BPM
display.setTextColor(WHITE);
display.setCursor(50,0);
display.println("BPM");
display.setCursor(50,18);
display.println(beatAvg+cr);
display.println();
display.println("---------------------");
//Envio del valor de BPM a puerto serial
Serial.println(particleSensor.getIR());
//Parte de oxigenacion
display.setCursor(50,45);
display.println("SPO2");
display.setCursor(50,54);
display.print(oxige);
display.println("%");
display.display();
tone(3,1000); //And tone the buzzer for a 100ms you can reduce it it will be better
//delay(100);
noTone(3); //Deactivate the buzzer to have the effect of a "bip"
//We sensed a beat!
long delta = millis() - lastBeat; //Measure duration between two beats
lastBeat = millis();

beatsPerMinute = 60 / (delta / 1000.0); //Calculating the BPM

if (beatsPerMinute < 255 && beatsPerMinute > 20) //To calculate the average we strore some values (4) then do some math to calculate the average
{
rates[rateSpot++] = (byte)beatsPerMinute; //Store this reading in the array
rateSpot %= RATE_SIZE; //Wrap variable

//Take average of readings
beatAvg = 0;
for (byte x = 0 ; x < RATE_SIZE ; x++)
beatAvg += rates[x];
beatAvg /= RATE_SIZE;
}
}

}
if (irValue < 7000){ //If no finger is detected it inform the user and put the average BPM to 0 or it will be stored for the next measure
beatAvg=0;
display.clearDisplay();
display.setTextSize(2);
display.setTextColor(WHITE);
display.setCursor(20,5);
display.println("Por favor  ");
display.setCursor(20,25);
display.println("colocar");
display.setCursor(20,45);
display.println("dedo :))");
display.display();
noTone(3);
}
oxige=oxi();
bpmaux=beatAvg;
}